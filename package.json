		"@easyops-cn/docusaurus-search-local": "0.55.3",
		"@mdx-js/react": "^3.1.1",
		"@netlify/blobs": "10.7.13",
		"@tailwindcss/typography": "^0.5.19",
		"@types/react": "^19.2.10",
		"acorn": "^8.14.1",
		"axios": "^1.18.1",
		"clsx": "^2.1.1",
