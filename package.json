		"@easyops-cn/docusaurus-search-local": "0.55.3",
		"@mdx-js/react": "^3.1.1",
		"@netlify/blobs": "11.0.1",
		"@tailwindcss/typography": "^0.5.20",
		"@types/react": "^19.2.18",
		"acorn": "^8.18.0",
		"axios": "^1.19.0",
		"clsx": "^2.1.1",
