		"posthog-docusaurus": "^2.0.5",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-inlinesvg": "^4.2.0",
		"react-loadable": "^5.5.0",
		"react-markdown": "^10.1.0",
		"react-player": "^3.4.0",
		"remark-gfm": "^4.0.1",
		"saxes": "6.0.0",
		"swagger-ui": "^5.32.14",
		"typescript": "^5.9.3",
		"webpack": "^5.104.1"
	},
	"devDependencies": {
		"@docusaurus/faster": "3.10.2",
		"@tailwindcss/postcss": "^4.1.18",
		"@testing-library/dom": "^10.4.1",
